{
  "id": "tabber",
  "name": "Tabber",
  "version": "1.1.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "whereareiam",
  "license": "MIT",
  "repository": "https://github.com/whereareiam/Tabber",
  "description": "macOS-like grouped app switcher overlay for Noctalia",
  "tags": ["Overlay", "Switcher", "Window Management"],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "groupWindowsByApp": true,
      "showHiddenWindows": true,
      "dimOpacity": 0.36,
      "cardSize": 108,
      "cardGap": 9,
      "iconSize": 64,
      "containerWidth": 0,
      "containerPadding": 18,
      "containerPaddingLinked": true,
      "containerPaddingTop": 18,
      "containerPaddingRight": 18,
      "containerPaddingBottom": 18,
      "containerPaddingLeft": 18,
      "showHeader": true,
      "headerAlignment": "space-between",
      "headerPadding": 0,
      "headerPaddingLinked": true,
      "headerPaddingTop": 0,
      "headerPaddingRight": 0,
      "headerPaddingBottom": 0,
      "headerPaddingLeft": 0,
      "headerText": "Tabber",
      "showWindowCount": true,
      "titleVisibility": "selected",
      "titleTruncationMode": "end",
      "actions": [
        {
          "id": "close",
          "keybind": "Alt+Q",
          "script": "scripts/close-selected-group.sh"
        },
        {
          "id": "hide",
          "keybind": "Alt+H",
          "script": "scripts/hide-selected-group.sh"
        }
      ]
    }
  }
}
